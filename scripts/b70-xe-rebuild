#!/usr/bin/env bash

set -euo pipefail

readonly PATCH_DIR=/var/lib/b70-xe-hwmon
readonly CACHE=/var/cache/b70-xe-hwmon
readonly LAUNCHPAD=https://launchpad.net/ubuntu/+archive/primary/+sourcefiles

log() {
	printf 'b70-xe-rebuild: %s\n' "$*"
}

die() {
	log "ERROR: $*"
	exit 1
}

kernel_release=${1:-$(uname -r)}
force=${2:-}

[[ $EUID -eq 0 ]] || die "must run as root"
[[ $kernel_release =~ ^[0-9A-Za-z._+-]+$ ]] || die "invalid kernel release: $kernel_release"
[[ -z $force || $force == --force ]] || die "usage: b70-xe-rebuild [kernel-release] [--force]"

exec 9>/run/lock/b70-xe-hwmon.lock
flock 9

readonly headers_package="linux-headers-$kernel_release"
readonly headers_dir="/usr/src/linux-headers-$kernel_release"
readonly boot_config="/boot/config-$kernel_release"
readonly modules_dir="/lib/modules/$kernel_release"
readonly stock_module="$modules_dir/kernel/drivers/gpu/drm/xe/xe.ko.zst"
readonly override_dir="$modules_dir/updates/b70-xe"
readonly override_module="$override_dir/xe.ko.zst"

dpkg-query -W "$headers_package" >/dev/null 2>&1 || die "$headers_package is not installed"
[[ -f $headers_dir/Module.symvers ]] || die "missing $headers_dir/Module.symvers"
[[ -f $boot_config ]] || die "missing $boot_config"
[[ -f $stock_module ]] || die "missing stock module: $stock_module"

if [[ -f $override_module && $force != --force ]]; then
	log "override already exists for $kernel_release"
	exit 0
fi

source_package=$(dpkg-query -W -f='${source:Package}' "$headers_package")
source_version=$(dpkg-query -W -f='${source:Version}' "$headers_package")

case $source_package in
	linux-hwe-6.17)
		patch_file="$PATCH_DIR/xe-hwmon-battlemage-telemetry.patch"
		;;
	linux-hwe-7.0)
		patch_file="$PATCH_DIR/xe-hwmon-battlemage-forcewake-7.0.patch"
		;;
	*)
		die "unsupported source package $source_package; leaving the stock driver in place"
		;;
esac
readonly patch_file
[[ -f $patch_file ]] || die "patch not found: $patch_file"

orig_version=${source_version%%-*}
readonly archive_url="https://archive.ubuntu.com/ubuntu/pool/main/${source_package:0:1}/$source_package"
readonly launchpad_url="$LAUNCHPAD/$source_package/$source_version"
readonly dsc_name="${source_package}_${source_version}.dsc"
readonly orig_name="${source_package}_${orig_version}.orig.tar.gz"
readonly diff_name="${source_package}_${source_version}.diff.gz"

mkdir -p "$CACHE"

download() {
	local name=$1
	local temporary="$CACHE/$name.tmp"

	if [[ ! -s $CACHE/$name ]]; then
		log "downloading $name"
		if ! wget -q --show-progress --timeout=30 --tries=2 \
			-O "$temporary" "$archive_url/$name"; then
			log "Ubuntu archive download failed; trying Launchpad"
			if ! wget -q --show-progress --timeout=30 --tries=2 \
				-O "$temporary" "$launchpad_url/$name"; then
				rm -f "$temporary"
				return 1
			fi
		fi
		mv "$temporary" "$CACHE/$name"
	fi
}

download "$dsc_name"
download "$orig_name"
download "$diff_name"

workdir=$(mktemp -d /var/tmp/b70-xe-hwmon.XXXXXX)
trap 'rm -rf "$workdir"' EXIT
source_dir="$workdir/source"

log "extracting Ubuntu source $source_version"
dpkg-source -x "$CACHE/$dsc_name" "$source_dir"

log "applying $(basename "$patch_file")"
patch --batch --forward --fuzz=0 -d "$source_dir" -p1 < "$patch_file"

cp "$boot_config" "$source_dir/.config"
cp "$headers_dir/Module.symvers" "$source_dir/Module.symvers"

log "preparing source tree"
make -s -C "$source_dir" olddefconfig
make -s -C "$source_dir" modules_prepare

# Ubuntu's source Makefile reports its upstream stable version (for example
# 6.17.13), while packaged modules use the Ubuntu ABI release. Force the exact
# installed release into module metadata after modules_prepare regenerates it.
printf '%s\n' "$kernel_release" > "$source_dir/include/config/kernel.release"
printf '#define UTS_RELEASE "%s"\n' "$kernel_release" > \
	"$source_dir/include/generated/utsrelease.h"

log "building xe.ko for $kernel_release"
PATH="$source_dir/drivers/gpu/drm/xe:$PATH" \
	make -s -C "$source_dir" -j"$(nproc)" \
	KERNELRELEASE="$kernel_release" \
	M=drivers/gpu/drm/xe \
	modules

built_module="$source_dir/drivers/gpu/drm/xe/xe.ko"
[[ -f $built_module ]] || die "build completed without producing xe.ko"

stock_vermagic=$(modinfo -F vermagic "$stock_module")
built_vermagic=$(modinfo -F vermagic "$built_module")
[[ $built_vermagic == "$stock_vermagic" ]] ||
	die "vermagic differs from Ubuntu's stock xe module"

modprobe --dump-modversions "$stock_module" | sort > "$workdir/stock.modversions"
modprobe --dump-modversions "$built_module" | sort > "$workdir/built.modversions"
comm -23 "$workdir/built.modversions" "$workdir/stock.modversions" > "$workdir/unsupported.modversions"
if [[ -s $workdir/unsupported.modversions ]]; then
	cat "$workdir/unsupported.modversions"
	die "rebuilt xe module has imports absent from Ubuntu's stock module"
fi

strip --strip-debug "$built_module"
zstd -f -q "$built_module" -o "$workdir/xe.ko.zst"

install -d "$override_dir"
pending_module="$override_dir/.xe.ko.zst.$$"
previous_module="$override_dir/.xe.ko.zst.previous.$$"
trap 'rm -rf "$workdir"; rm -f "$pending_module" "$previous_module"' EXIT
install -m 0644 "$workdir/xe.ko.zst" "$pending_module"

if [[ -f $override_module ]]; then
	ln "$override_module" "$previous_module"
fi

mv -f "$pending_module" "$override_module"

if ! depmod -a "$kernel_release" || ! update-initramfs -u -k "$kernel_release"; then
	log "publication failed; restoring the previous driver"
	if [[ -f $previous_module ]]; then
		mv -f "$previous_module" "$override_module"
	else
		rm -f "$override_module"
	fi
	depmod -a "$kernel_release" || true
	update-initramfs -u -k "$kernel_release" || true
	die "could not publish the verified module"
fi

rm -f "$previous_module"

log "installed verified override: $override_module"

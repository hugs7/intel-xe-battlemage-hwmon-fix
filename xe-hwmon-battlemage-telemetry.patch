+static int xe_hwmon_pcode_read_thermal_info(struct xe_hwmon *hwmon)
+{
+	struct xe_tile *root_tile = xe_device_get_root_tile(hwmon->xe);
+	u32 config = 0;
+	u32 count;
+	int ret;
+
+	ret = xe_pcode_read(root_tile, PCODE_MBOX(PCODE_THERMAL_INFO, READ_THERMAL_LIMITS, 0),
+			    &hwmon->temp.data[0], &hwmon->temp.data[1]);
+	if (ret)
+		return ret;
+
+	ret = xe_pcode_read(root_tile, PCODE_MBOX(PCODE_THERMAL_INFO, READ_THERMAL_CONFIG, 0),
+			    &config, NULL);
+	if (ret)
+		return ret;
+
+	count = REG_FIELD_GET(TEMP_MASK, config);
+	if (count <= TEMP_INDEX_MCTRL + 1 || count > 9)
+		return -EPROTO;
+
+	hwmon->temp.count = count;
+	return 0;
+}
+
+static int xe_hwmon_get_mctrl_temp(struct xe_hwmon *hwmon, long *val)
+{
+	struct xe_tile *root_tile = xe_device_get_root_tile(hwmon->xe);
+	s32 average = 0;
+	int ret, i;
+
+	for (i = 0; i < DIV_ROUND_UP(TEMP_LIMIT_MAX, sizeof(u32)); i++) {
+		u32 word = 0;
+
+		ret = xe_pcode_read(root_tile,
+				    PCODE_MBOX(PCODE_THERMAL_INFO, READ_THERMAL_DATA, i),
+				    &word, NULL);
+		if (ret)
+			return ret;
+
+		memcpy(&hwmon->temp.value[i * sizeof(word)], &word, sizeof(word));
+	}
+
+	for (i = TEMP_INDEX_MCTRL; i < hwmon->temp.count - 1; i++)
+		average += hwmon->temp.value[i];
+
+	average /= hwmon->temp.count - TEMP_INDEX_MCTRL - 1;
+	*val = average * MILLIDEGREE_PER_DEGREE;
+	return 0;
+}
+
+static int xe_hwmon_get_pcie_temp(struct xe_hwmon *hwmon, long *val)
+{
+	struct xe_tile *root_tile = xe_device_get_root_tile(hwmon->xe);
+	u32 data = 0;
+	int ret;
+
+	ret = xe_pcode_read(root_tile,
+			    PCODE_MBOX(PCODE_THERMAL_INFO, READ_THERMAL_DATA,
+					       PCIE_SENSOR_GROUP_ID),
+			    &data, NULL);
+	if (ret)
+		return ret;
+
+	/* The Arc Pro B70 G31 PCIe sensor is in the upper half of the response. */
+	data = REG_FIELD_GET(PCIE_SENSOR_MASK, data);
+	*val = (s8)REG_FIELD_GET(TEMP_MASK, data) * MILLIDEGREE_PER_DEGREE;
+	return 0;
+}

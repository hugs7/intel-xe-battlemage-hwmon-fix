+static bool xe_hwmon_vram_channel_available(struct xe_hwmon *hwmon, int channel)
+{
+	int vram_id = channel - CHANNEL_VRAM_N;
+	u32 reg_val;
+
+	if (!xe_reg_is_valid(xe_hwmon_get_reg(hwmon, REG_TEMP, channel)) ||
+	    xe_hwmon_temp_mmio_read(hwmon, channel, &reg_val) ||
+	    !reg_val || reg_val == U32_MAX)
+		return false;
+
+	snprintf(hwmon->temp.vram_label[vram_id], MAX_LABEL_SIZE,
+		 "vram_ch_%d", vram_id);
+	return true;
+}
